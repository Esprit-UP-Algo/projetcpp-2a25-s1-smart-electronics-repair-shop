       <string notr="true">QPushButton {
    border: 2px solid black;
    border-radius: 8px;
    font-weight: bold;
    font-size: 18px;              /* texte plus grand */
    background-color: rgb(41, 102, 148); /* bleu normal */
    color: white;
    padding: 8px 16px;
}

/* Quand la souris passe dessus */
QPushButton:hover {
    background-color: rgb(61, 122, 168); /* bleu plus clair */
}

/* Quand on clique dessus */
QPushButton:pressed {
    background-color: rgb(81, 142, 188); /* encore plus clair */
}

/* Bouton actif (par ex. quand on est sur la page 1) */
QPushButton[active=&quot;true&quot;] {
    background-color: #10b981;  /* vert quand actif */
    color: white;
}</string>
