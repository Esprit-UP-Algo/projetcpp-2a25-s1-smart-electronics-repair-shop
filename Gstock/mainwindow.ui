    <property name="styleSheet">
     <string notr="true">/* ---- Style du QStackedWidget ---- */
QStackedWidget {
    background-color: rgb(209, 209, 209); /* couleur gris clair */
    border: 2px solid black;
    border-radius: 8px;
}

/* ---- Style des deux pages ---- */
QWidget#page_1 {
    background-color: rgb(209, 209, 209); /* même gris clair */
    color: black;
    font-size: 18px;
}

QWidget#page_2 {
    background-color: rgb(209, 209, 209); /* même gris clair */
    color: black;
    font-size: 18px;
}

/* ---- Style des boutons ---- */
QPushButton {
    border: 2px solid black;
    border-radius: 8px;
    font-weight: bold;
    font-size: 18px;
    background-color: rgb(41, 102, 148); /* bleu normal */
    color: white;
    padding: 8px 16px;
}

/* Quand la souris passe dessus */
QPushButton:hover {
    background-color: rgb(61, 122, 168); /* bleu plus clair */
}

/* Quand on clique dessus */
QPushButton:pressed {
    background-color: rgb(81, 142, 188); /* encore plus clair */
}

/* Bouton actif (ex. page 1 active) */
QPushButton[active=&quot;true&quot;] {
    background-color: #10b981; /* vert */
    color: white;
}</string>
    </property>
    <property name="currentIndex">
     <number>0</number>
    </property>
