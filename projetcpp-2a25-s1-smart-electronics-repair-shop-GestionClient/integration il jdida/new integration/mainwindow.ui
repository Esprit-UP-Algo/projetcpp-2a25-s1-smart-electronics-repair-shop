        <property name="styleSheet">
         <string notr="true">QComboBox {
    background-color: rgb(255, 255, 255);   /* white background */
    color: #1f2937;                         /* text color */
    border: 2px solid #3b82f6;              /* blue border */
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 14px;
}

/* Dropdown arrow area */
QComboBox::drop-down {
    border-left: 2px solid #3b82f6;         /* same blue as border */
    width: 24px;
}

/* Default arrow */
QComboBox::down-arrow {
    image: none;                            /* remove system icon */
    border: solid #1f2937;
    border-width: 0 2px 2px 0;              /* create a chevron */
    display: inline-block;
    padding: 4px;
    transform: rotate(45deg);               /* arrow shape */
    margin-right: 6px;
}

/* Popup list */
QComboBox QAbstractItemView {
    background-color: rgb(255, 255, 255);   /* white background */
    color: #1f2937;                         /* text color */
    border: 2px solid #3b82f6;              /* blue border */
    border-radius: 6px;
    selection-background-color: #3b82f6;    /* blue selection */
    selection-color: white;                 /* white text when selected */
}
</string>
