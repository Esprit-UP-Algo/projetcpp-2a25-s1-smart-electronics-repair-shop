       </rect>
      </property>
      <property name="styleSheet">
       <string notr="true">/* ---- Style du QTabWidget ---- */
QTabWidget {
    background-color: rgb(209, 209, 209); /* gris clair */
    border: 2px solid black;
    border-radius: 8px;
}

/* ---- Style des pages internes ---- */
QTabWidget QWidget {
    background-color: rgb(209, 209, 209);
    color: black;
    font-size: 18px;
}

/* ---- Style des onglets ---- */
QTabBar::tab {
    background: rgb(41, 102, 148); /* bleu normal */
    color: white;
    border: 2px solid black;
    border-radius: 8px 8px 0 0;
    padding: 8px 16px;
    font-weight: bold;
    font-size: 16px;
    margin-right: 2px;
}

/* Onglet au survol */
QTabBar::tab:hover {
    background: rgb(61, 122, 168); /* bleu plus clair */
}

/* Onglet sélectionné */
QTabBar::tab:selected {
    background: rgb(81, 142, 188); /* encore plus clair */
    color: white;
}

/* Onglet désactivé */
QTabBar::tab:!selected {
    background: rgb(41, 102, 148); /* bleu normal */
    color: white;
}

/* Onglet actif avec propriété active */
QTabBar::tab[active=&quot;true&quot;] {
    background-color: #10b981; /* vert */
    color: white;
}
</string>
