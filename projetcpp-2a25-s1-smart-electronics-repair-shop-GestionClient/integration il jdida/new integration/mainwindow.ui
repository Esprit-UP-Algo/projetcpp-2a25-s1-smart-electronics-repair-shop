           <property name="styleSheet">
            <string notr="true">QDateEdit {
    background-color: rgb(255, 255, 255);
    color: #1f2937;              /* typed text color */
    border: 2px solid #3b82f6;   /* blue border */
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 14px;
}

QDateEdit:focus {
    border: 2px solid #2563EB;        /* bleu quand focus */
    background-color: #F3F4F6;        /* léger gris */
}

/* Bouton flèche */
QDateEdit::drop-down {
    border: none;
    width: 20px;
    background-color: #2563EB;        /* bouton bleu */
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
}

QDateEdit::down-arrow {
    image: url(:/icons/arrow-down.png);  /* icône optionnelle */
    width: 12px;
    height: 12px;
}
