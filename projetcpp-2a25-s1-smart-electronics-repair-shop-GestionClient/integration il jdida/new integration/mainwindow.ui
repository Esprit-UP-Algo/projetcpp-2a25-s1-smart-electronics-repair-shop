        <property name="styleSheet">
         <string notr="true">QTableWidget {
    background-color: rgb(41, 102, 148);   /* blue background */
    border: 2px solid black;
    border-radius: 8px;
    font-weight: bold;
    font-size: 14px;
    gridline-color: black;                 /* cell grid lines */
    color: white;                          
    selection-background-color: #10b981;
    selection-color: white;
    outline: 0;
}

QTableWidget::item {
    border: 1px solid black;               /* give each cell a border */
    padding: 4px;
}

QHeaderView::section {
    background-color: rgb(41, 102, 148);
    color: white;
    border: 1px solid black;              /* column header border */
    padding: 4px;
    font-weight: bold;
}
</string>
